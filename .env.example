# Copy to .env and adjust. Do not commit real values.

# Mock API keys (any string; two separate keys so n8n can prove read-only vs read-write).
API_KEY_RW=rw-dev-local-change-me
API_KEY_RO=ro-dev-local-change-me

# Fault injection for the mock APIs. 0.0 disables, 0.2 means ~20% of requests return 503.
# Use this to demo n8n retry/backoff.
FAULT_RATE=0.0

# Simple global rate limit for the mock APIs (requests per second). 429 above this.
RATE_LIMIT_RPS=5

# Where the mock-apis SQLite file lives. Mounted as a volume by docker compose.
DB_PATH=/data/lab.db

# Base URL n8n uses to reach the mock APIs. "mock-apis" is the compose service name;
# use "http://localhost:8000" when running outside Docker.
MOCK_APIS_BASE_URL=http://mock-apis:8000

# Optional: real Claude for WF2. Leave unset to run WF2 in rule-based mock mode.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
